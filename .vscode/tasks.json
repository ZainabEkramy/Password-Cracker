{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build OpenMP program",
            "type": "shell",
            "command": "g++",
            "args": [
                "${workspaceFolder}/PasswordCracker.c",
                "-fopenmp",
                "-o",
                "${workspaceFolder}/PasswordCracker"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
